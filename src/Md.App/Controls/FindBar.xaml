<UserControl
    x:Class="Md.App.Controls.FindBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The find panel (shell-design.md §3.5): a compact card over the editor's top-right corner, the
        way Windows 11's own editors lay it out. Row one is the chevron that shows the replace row,
        the query, the count, Previous, Next and Done; row two, hidden until Ctrl+H or the chevron,
        is the replacement with Replace and Replace All. Structure and names only — the icons,
        labels, tooltips and placeholders come from Md.App.Logic.Strings.Find, the face and brushes
        from the code-behind, and every handler is wired there too (no Click attributes, so nothing
        here depends on the XAML compiler).
    -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="ToggleReplaceButton" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox x:Name="QueryBox" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" />
        <TextBlock x:Name="CountText" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" />
        <Button x:Name="PreviousButton" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" />
        <Button x:Name="NextButton" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" />
        <Button x:Name="DoneButton" Grid.Row="0" Grid.Column="5" VerticalAlignment="Center" />
        <Grid x:Name="ReplaceRow" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ReplaceBox" Grid.Column="0" VerticalAlignment="Center" />
            <Button x:Name="ReplaceButton" Grid.Column="1" VerticalAlignment="Center" />
            <Button x:Name="ReplaceAllButton" Grid.Column="2" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>

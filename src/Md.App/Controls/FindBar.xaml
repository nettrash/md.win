<UserControl
    x:Class="Md.App.Controls.FindBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        One row above the footer, hidden by default (shell-design.md §3.5): the query and the
        replacement, then Next / Previous / Replace / Replace All / Done. Structure and names only —
        the labels and placeholders come from Md.App.Logic.Strings.Find, the face and brushes from
        the code-behind, and every handler is wired there too (no Click attributes, so nothing here
        depends on the XAML compiler).
    -->
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="QueryBox" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox x:Name="ReplaceBox" Grid.Column="1" VerticalAlignment="Center" />
        <Button x:Name="NextButton" Grid.Column="2" VerticalAlignment="Center" />
        <Button x:Name="PreviousButton" Grid.Column="3" VerticalAlignment="Center" />
        <Button x:Name="ReplaceButton" Grid.Column="4" VerticalAlignment="Center" />
        <Button x:Name="ReplaceAllButton" Grid.Column="5" VerticalAlignment="Center" />
        <Button x:Name="DoneButton" Grid.Column="6" VerticalAlignment="Center" />
    </Grid>
</UserControl>

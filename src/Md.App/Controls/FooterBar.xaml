<UserControl
    x:Class="Md.App.Controls.FooterBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        "N words · M characters", right-aligned on the secondary paper (shell-design.md §5.5).
        Structure only: the padding, the Georgia face, the tabular figures and the brushes are set in
        the code-behind, and the text comes from Md.App.Logic.Strings.Footer.
    -->
    <Border x:Name="Root">
        <TextBlock x:Name="Counts" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Border>
</UserControl>

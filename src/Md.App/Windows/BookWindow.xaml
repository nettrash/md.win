<Window
    x:Class="Md.App.BookWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The Book window (shell-design.md §8.1): menu row, a SplitView of sidebar and detail, the
        footer and the conflict / save-error bar. Structure and x:Name only — every label, glyph,
        brush, flyout and handler is set in BookWindow.xaml.cs, and the sidebar's rows are built by
        Md.App.Book.BookSidebarBuilder. No x:Bind, no {Binding}, no ThemeResource.

        Rows: 0 menu · 1 body (split view, empty state, export canvas, print overlay) · 2 footer ·
        3 InfoBar. The empty state and the split view swap places; the canvas is off-canvas and the
        print overlay covers the body when a print is being previewed.
    -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl
            x:Name="MenuSlot"
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch" />

        <Grid x:Name="Body" Grid.Row="1">
            <SplitView x:Name="Split">
                <SplitView.Pane>
                    <Grid x:Name="SidebarRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <CommandBar x:Name="SidebarBar" Grid.Row="0">
                            <CommandBar.PrimaryCommands>
                                <AppBarButton x:Name="NewChapterButton" />
                            </CommandBar.PrimaryCommands>
                        </CommandBar>
                        <ListView x:Name="Sidebar" Grid.Row="1" />
                    </Grid>
                </SplitView.Pane>
                <SplitView.Content>
                    <Grid x:Name="DetailRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <CommandBar x:Name="DetailBar" Grid.Row="0">
                            <CommandBar.PrimaryCommands>
                                <AppBarToggleButton x:Name="EditModeButton" />
                                <AppBarToggleButton x:Name="SplitModeButton" />
                                <AppBarToggleButton x:Name="PreviewModeButton" />
                                <AppBarSeparator />
                                <AppBarButton x:Name="PreviousArticleButton" />
                                <AppBarButton x:Name="NextArticleButton" />
                                <AppBarSeparator />
                                <AppBarButton x:Name="ContentsButton" />
                                <AppBarButton x:Name="NotesButton" />
                                <AppBarSeparator />
                                <AppBarButton x:Name="ShareButton" />
                            </CommandBar.PrimaryCommands>
                        </CommandBar>
                        <Grid x:Name="StageRoot" Grid.Row="1">
                            <ContentControl
                                x:Name="PanesSlot"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                            <StackPanel
                                x:Name="StagePlaceholder"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <FontIcon x:Name="StageIcon" HorizontalAlignment="Center" />
                                <TextBlock x:Name="StageTitle" HorizontalAlignment="Center" />
                                <TextBlock x:Name="StageMessage" HorizontalAlignment="Center" />
                                <Button x:Name="StageButton" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </SplitView.Content>
            </SplitView>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <FontIcon x:Name="EmptyIcon" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyMessage" HorizontalAlignment="Center" />
                <Button x:Name="OpenBookButton" HorizontalAlignment="Center" />
            </StackPanel>

            <Canvas x:Name="ExportCanvas" />

            <ContentControl
                x:Name="PrintOverlaySlot"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </Grid>

        <Grid x:Name="Footer" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="FooterStatus" Grid.Column="0" VerticalAlignment="Center">
                <FontIcon x:Name="FooterIcon" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" />
                <Button x:Name="FooterPrimaryButton" VerticalAlignment="Center" />
                <Button x:Name="FooterSecondaryButton" VerticalAlignment="Center" />
            </StackPanel>
            <ContentControl x:Name="FooterCountsSlot" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>

        <InfoBar x:Name="Info" Grid.Row="3" />
    </Grid>
</Window>

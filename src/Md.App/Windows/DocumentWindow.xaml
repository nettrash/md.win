<Window
    x:Class="Md.App.DocumentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Md.App.Controls"
    xmlns:ui="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <!--
        One document window (shell-design.md §1.3, §11.2): the MenuBar row, the content, the find
        bar, the conflict / save-error InfoBar and the footer, with the Zen capsule, the off-canvas
        export surface and the print-overlay host layered over all of them.

        The attached rows are written `ui:Grid.Row` against a second prefix for the SAME presentation
        namespace: tools/xamlcheck resolves an attached property's owner with the ELEMENT's prefix, so
        a bare `Grid.Row` on a `controls:` element is looked up as `Md.App.Controls.Grid` and reported
        as unknown. An explicit prefix is valid XAML for the real compiler and unambiguous for the lint.

        Structure and x:Name only. There is no x:Bind, no {Binding}, no ThemeResource and no Click
        attribute: the menu is built from Md.App.Logic's CommandTable in the code-behind, every
        brush is read from Application.Current.Resources with a typed Palette fallback, and Zen is a
        re-arrangement of ContentHost's own row and column definitions rather than a second copy of
        the panes — re-parenting a live WebView2 is exactly the kind of thing that cannot be
        verified from a Mac.
    -->
    <Grid x:Name="Root">
        <Grid x:Name="Chrome">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl
                x:Name="MenuSlot"
                ui:Grid.Row="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" />

            <Grid x:Name="ContentHost" ui:Grid.Row="1">
                <controls:ArticlePanes x:Name="Panes" />
            </Grid>

            <controls:FindBar x:Name="Find" ui:Grid.Row="2" Visibility="Collapsed" />

            <InfoBar
                x:Name="Info"
                ui:Grid.Row="3"
                IsOpen="False"
                IsClosable="False" />

            <controls:FooterBar x:Name="Footer" ui:Grid.Row="4" />
        </Grid>

        <controls:ZenControls x:Name="ZenCapsule" Visibility="Collapsed" />

        <!-- WP6's export renderer parks a fresh WebView2 here at Canvas.Left = -10000: visible to
             Chromium (so its timers are not throttled), off screen to the reader. -->
        <Canvas x:Name="ExportCanvas" IsHitTestVisible="False" />

        <!-- WP6's PrintOverlay: a real, visible WebView2 is the only way ShowPrintUI(Browser) draws
             its preview, so the overlay covers the window rather than hiding off-canvas. -->
        <Grid x:Name="OverlayHost" Visibility="Collapsed" />
    </Grid>
</Window>
